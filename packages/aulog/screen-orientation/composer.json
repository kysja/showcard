{
    "name": "aulog/screen-orientation",
    "description": "Locks the screen to landscape or portrait at runtime",
    "type": "nativephp-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Aulog\\ScreenOrientation\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aulog\\ScreenOrientation\\ScreenOrientationServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
